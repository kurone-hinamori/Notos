{
  "$schema": "https://schema.tauri.app/config/2",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ1OUMyRkY4NjM1MTUyNTYKUldSV1VsRmorQytjUlViM2xnQ3I2dWtXSlVWNmoraE0xY1dTSW9IOTl5Y3hQQmgyQTI3TGJGOWMK",
