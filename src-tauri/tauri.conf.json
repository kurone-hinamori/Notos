        "https://github.com/kurone-hinamori/Notos/releases/latest/download/latest.json"
      ]
    }
  },
  "productName": "Notos",
  "version": "0.1.2",
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "width": 1280,
        "minHeight": 600,
        "label": "main",
        "height": 820,
        "minWidth": 960,
        "title": "Notos"
      }
    ]
  },
  "identifier": "io.github.kurone-hinamori.notos",
  "mainBinaryName": "notos",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev"
  },
  "bundle": {
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Japanese"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
